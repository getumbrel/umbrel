<UserControl x:Class="Umbrel.Views.DeviceIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- macOS DeviceIcon. Callers set Placement, and the icon sizes itself for its kind there.
       The renders are much larger than the card, and WPF's default scaling leaves jagged
       edges at that ratio. -->
  <Grid>
    <Image x:Name="Render" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
    <!-- Pi mark on a device-shaped tile, as in umbrelOS. -->
    <Border x:Name="PiTile" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="#7A525252" BorderThickness="1">
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,0.5">
          <GradientStop Color="#54FFFFFF" Offset="0" />
          <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>
      </Border.BorderBrush>
      <Image x:Name="PiMark" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
             RenderOptions.BitmapScalingMode="HighQuality" />
    </Border>
  </Grid>
</UserControl>
