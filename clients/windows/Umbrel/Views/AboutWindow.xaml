<Window x:Class="Umbrel.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Umbrel.ViewModels"
        Title="About Umbrel" Width="300" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ThemeMode="System"
        FontFamily="{StaticResource UIFont}" FontSize="14" UseLayoutRounding="True">
  <!-- The macOS standard About panel: app icon, name, version with build, copyright,
       following the system light or dark theme. -->
  <Window.Resources>
    <!-- Centered, wrapping text in the theme's foreground. -->
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
  </Window.Resources>
  <StackPanel Margin="24,24,24,28">
    <Image Source="{Binding Source={x:Static vm:Presentation.AppIconPath}}" Width="64" Height="64"
           RenderOptions.BitmapScalingMode="HighQuality" />
    <TextBlock Text="Umbrel" FontWeight="SemiBold" Margin="0,12,0,0" />
    <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
    <TextBlock x:Name="CopyrightText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,12,0,0" />
  </StackPanel>
</Window>
