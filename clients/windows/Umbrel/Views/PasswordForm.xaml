<UserControl x:Class="Umbrel.Views.PasswordForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Umbrel.Views"
             x:Name="Root">
  <UserControl.Resources>
    <SolidColorBrush x:Key="ActiveSlotBrush" Color="#66FFFFFF" />
    <!-- One 2FA slot: 36x40, radius 10, 8 apart. Code-behind sets the digit and outline. -->
    <Style x:Key="Slot" TargetType="Border">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="#0DFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    </Style>
    <!-- Consolas ships with Windows 10 and 11; it has no semibold face, so this renders its bold. -->
    <Style x:Key="Digit" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#E6FFFFFF" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <!-- macOS PasswordForm: label, then a password capsule or six 2FA slots, then the error. -->
  <StackPanel>
    <TextBlock Text="{Binding Label, ElementName=Root}" FontSize="12" Foreground="#80FFFFFF"
               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

    <!-- Text 14 in, as on macOS: 1 border + 11 + the password box's own 2 inset. The eye
         button has no inset, so its side gets 13. -->
    <Border x:Name="PasswordCapsule" Margin="0,12,0,0" Height="40" CornerRadius="20" Padding="11,0,13,0"
            Background="#0DFFFFFF" BorderThickness="1" BorderBrush="{StaticResource HairlineBrush}"
            Visibility="{Binding RequiresTotp, ElementName=Root, Converter={StaticResource InverseBoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The text box view insets its text by 2 for the caret; the placeholder matches it.
             25% white is the macOS dark placeholder color. -->
        <TextBlock x:Name="Placeholder" Text="Password" Margin="2,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                   FontSize="13" FontWeight="SemiBold" Foreground="#40FFFFFF" TextWrapping="NoWrap" />
        <PasswordBox x:Name="PasswordField" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="0"
                     FontSize="13" FontWeight="SemiBold" AutomationProperties.Name="Password"
                     PasswordChanged="PasswordField_PasswordChanged" KeyDown="Field_KeyDown" />
        <!-- Shown in place of the PasswordBox while the password is revealed, as the Mac swaps
             SecureField for TextField. Undo is off so the plain text isn't kept after hiding. -->
        <TextBox x:Name="RevealedField" Visibility="Collapsed" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                 Padding="0" FontSize="13" FontWeight="SemiBold" IsUndoEnabled="False" AutomationProperties.Name="Password"
                 TextChanged="RevealedField_TextChanged" KeyDown="Field_KeyDown" />

        <!-- Not focusable, like a macOS plain button, so a click leaves focus in the field. -->
        <Button x:Name="RevealButton" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource LinkButton}"
                Focusable="False" AutomationProperties.Name="Show password" Click="RevealButton_Click"
                Visibility="{Binding Loading, ElementName=Root, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock x:Name="RevealGlyph" Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                     Foreground="#66FFFFFF" />
        </Button>
        <v:Spinner Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                   Visibility="{Binding Loading, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>

    <Grid x:Name="CodeRow" Margin="0,12,0,0"
          Visibility="{Binding RequiresTotp, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
      <!-- Transparent but still focusable and hit-testable: it takes the typing and clicks
           while the slots drawn over it show the code. -->
      <TextBox x:Name="CodeField" Width="256" Height="40" Opacity="0" AutomationProperties.Name="Verification code"
               TextChanged="CodeField_TextChanged" KeyDown="Field_KeyDown" IsKeyboardFocusedChanged="CodeField_IsKeyboardFocusedChanged" />
      <StackPanel x:Name="Slots" Orientation="Horizontal" HorizontalAlignment="Center" IsHitTestVisible="False">
        <Border Style="{StaticResource Slot}" Margin="0"><TextBlock Style="{StaticResource Digit}" /></Border>
        <Border Style="{StaticResource Slot}"><TextBlock Style="{StaticResource Digit}" /></Border>
        <Border Style="{StaticResource Slot}"><TextBlock Style="{StaticResource Digit}" /></Border>
        <Border Style="{StaticResource Slot}"><TextBlock Style="{StaticResource Digit}" /></Border>
        <Border Style="{StaticResource Slot}"><TextBlock Style="{StaticResource Digit}" /></Border>
        <Border Style="{StaticResource Slot}"><TextBlock Style="{StaticResource Digit}" /></Border>
      </StackPanel>
      <v:Spinner HorizontalAlignment="Right" VerticalAlignment="Center"
                 Visibility="{Binding Loading, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <TextBlock Text="{Binding Error, ElementName=Root}" Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource RedBrush}"
               Visibility="{Binding Error, ElementName=Root, Converter={StaticResource NullToVisibility}}" />
  </StackPanel>
</UserControl>
