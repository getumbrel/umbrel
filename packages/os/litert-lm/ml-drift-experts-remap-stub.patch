diff -ruN a/ml_drift/common/kernels/google/custom/BUILD b/ml_drift/common/kernels/google/custom/BUILD
--- a/ml_drift/common/kernels/google/custom/BUILD	1970-01-01 00:00:00
+++ b/ml_drift/common/kernels/google/custom/BUILD	1970-01-01 00:00:00
@@ -0,0 +1,18 @@
+# Stub for a Google-internal ML Drift kernel package that LiteRT's
+# ml_drift_delegate/delegate/composite:experts_remap_builder references but that
+# is not published in the open-source ml-drift repository. Only used for
+# Mixture-of-Experts models; stops with a clear message if ever reached.
+load("@rules_cc//cc:defs.bzl", "cc_library")
+
+package(default_visibility = ["//visibility:public"])
+
+cc_library(
+    name = "experts_remap",
+    srcs = ["experts_remap.cc"],
+    hdrs = ["experts_remap.h"],
+    deps = [
+        "//ml_drift/common/task:gpu_operation",
+        "//ml_drift/common/task:tensor_desc",
+        "@com_google_absl//absl/log:absl_log",
+    ],
+)
