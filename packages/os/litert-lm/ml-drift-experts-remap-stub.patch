@@ -0,0 +1,23 @@
+#include "ml_drift/common/kernels/google/custom/experts_remap.h"
+
+#include "absl/log/absl_log.h"
+
+namespace ml_drift {
+namespace {
+[[noreturn]] void Unavailable() {
+  ABSL_LOG(FATAL) << "ML Drift MoE experts-remap kernels are not available in "
+                     "umbrelOS's build of LiteRT-LM.";
+}
+}  // namespace
+std::unique_ptr<GPUOperation> CreateExpertsRemapOp(const TensorDescriptor&,
+                                                   const TensorDescriptor&) { Unavailable(); }
+std::unique_ptr<GPUOperation> CreateOffsetsOp() { Unavailable(); }
+std::unique_ptr<GPUOperation> CreateLinearizeMapOp(const TensorDescriptor&,
+                                                   const TensorDescriptor&) { Unavailable(); }
+std::unique_ptr<GPUOperation> CreateExpertsRemapToOp(const TensorDescriptor&,
+                                                     const TensorDescriptor&,
+                                                     const TensorDescriptor&) { Unavailable(); }
+std::unique_ptr<GPUOperation> CreateExpertsRemapFromOp(const TensorDescriptor&,
+                                                       const TensorDescriptor&,
+                                                       const TensorDescriptor&) { Unavailable(); }
+}  // namespace ml_drift
