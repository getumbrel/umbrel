Description: Make service-types.db reproducible
 Building the package should give the same bytes on any machine, so anyone can
 check a build by rebuilding it. dbm.gnu lets GDBM size the database's blocks by
 the st_blksize of the filesystem it's written to: 4KiB on ext4, but 128KiB on
 ZFS, so the database, and so the package, depended on the build machine's
 filesystem. Create the database with libgdbm directly instead, using the 4KiB
 block size an ext4 build gets. Entries are stored in the same order, so on ext4
 the database is unchanged.
Forwarded: not-needed
---
--- a/service-type-database/build-db
+++ b/service-type-database/build-db
@@ -20,11 +20,44 @@
 import sys
 
 if sys.argv[1] == '--gnu':
-    if sys.version_info >= (3,):
-        import dbm.gnu as chosen_dbm
-    else:
-        import gdbm as chosen_dbm
+    # dbm.gnu lets GDBM size the database's blocks by the st_blksize of the
+    # filesystem it's written to, so the database would differ between build
+    # machines and the build wouldn't be reproducible. Call libgdbm directly to
+    # give it a fixed block size instead.
+    import ctypes, ctypes.util
 
+    class datum(ctypes.Structure):
+        _fields_ = [("dptr", ctypes.c_char_p), ("dsize", ctypes.c_int)]
+
+    class chosen_dbm:
+        GDBM_NEWDB = 3
+        GDBM_REPLACE = 1
+        BLOCK_SIZE = 4096
+
+        libgdbm = ctypes.CDLL(ctypes.util.find_library("gdbm"), use_errno=True)
+        libgdbm.gdbm_open.restype = ctypes.c_void_p
+        libgdbm.gdbm_open.argtypes = [ctypes.c_char_p, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_void_p]
+        libgdbm.gdbm_store.argtypes = [ctypes.c_void_p, datum, datum, ctypes.c_int]
+        libgdbm.gdbm_close.argtypes = [ctypes.c_void_p]
+
+        @classmethod
+        def open(cls, filename, flag):
+            assert flag == "n"
+            return cls(filename)
+
+        def __init__(self, filename):
+            self.dbf = self.libgdbm.gdbm_open(filename.encode(), self.BLOCK_SIZE, self.GDBM_NEWDB, 0o666, None)
+            if not self.dbf:
+                raise OSError(ctypes.get_errno(), "gdbm_open failed", filename)
+
+        def __setitem__(self, key, value):
+            key, value = key.encode(), value.encode()
+            if self.libgdbm.gdbm_store(self.dbf, datum(key, len(key)), datum(value, len(value)), self.GDBM_REPLACE) != 0:
+                raise OSError("gdbm_store failed")
+
+        def close(self):
+            self.libgdbm.gdbm_close(self.dbf)
+
     sys.argv[1:] = sys.argv[2:]
 elif sys.argv[1] == '--ndbm':
     if sys.version_info >= (3,):
