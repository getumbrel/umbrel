#!/bin/bash

# The root filesystem overlay is discarded on every boot, so NetworkManager forgets
# static IP settings and brings interfaces up on DHCP until umbreld restores them.
# Anything that starts in that window, like apps Docker restarts after a power cut,
# sees the interface without its static IP (or with no IP at all if the device is
# the network's DHCP server). Write the saved static IP settings as NetworkManager
# connections before it starts so interfaces come up with them straight away.

UMBREL_YAML=/home/umbrel/umbrel/umbrel.yaml
CONNECTIONS_DIR=/etc/NetworkManager/system-connections

# NetworkManager ignores connection files that other users can read
umask 077

yq eval '.settings.staticIp // {} | to_entries | .[] | [.key, .value.ip, .value.subnetPrefix, .value.gateway, (.value.dns | join(";"))] | join(" ")' "$UMBREL_YAML" 2>/dev/null |
while read -r mac ip subnet_prefix gateway dns; do
    # yq prints an empty line when there are no saved static IPs
    [[ -n "$mac" ]] || continue

    # Find the physical ethernet interface with this MAC address
    device=""
    for interface in /sys/class/net/*; do
        [[ -e "$interface/device" && ! -e "$interface/wireless" ]] || continue
        [[ "$(cat "$interface/address")" == "$mac" ]] && device=$(basename "$interface")
    done
    if [[ -z "$device" ]]; then
        echo "No ethernet interface found with MAC address $mac, skipping"
        continue
    fi

    echo "Restoring static IP $ip/$subnet_prefix for $mac ($device)"
    # NetworkManager reads a connection file without addr-gen-mode as a legacy profile
    # and derives IPv6 addresses from the MAC address, so set the default it uses for
    # the connections it creates itself.
    cat > "$CONNECTIONS_DIR/static-ip-$device.nmconnection" << EOF
[connection]
id=static-ip-$device
uuid=$(cat /proc/sys/kernel/random/uuid)
type=ethernet
interface-name=$device

[ipv4]
method=manual
address1=$ip/$subnet_prefix
gateway=$gateway
dns=$dns

[ipv6]
addr-gen-mode=default
method=auto
EOF
done
