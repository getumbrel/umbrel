[Unit]
Description=Socket of the models that read the text in pictures
ConditionPathExists=/usr/lib/python3/dist-packages/onnxruntime

[Socket]
# Only root, so only umbreld, can reach it
ListenStream=/run/umbrel-embeddings-text/text.sock
SocketMode=0600
DirectoryMode=0700

[Install]
WantedBy=sockets.target
