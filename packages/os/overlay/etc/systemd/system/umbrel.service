[Unit]
Description=Umbrel daemon
Wants=umbrel-custom-pre-start.service libvirtd.socket
After=network-online.target docker.service libvirtd.socket umbrel-custom-pre-start.service
# Umbreld gracefully shuts down running Machines when it stops, so on host
# shutdown it must stop before libvirt (the monolithic libvirtd today, or the
# modular virtqemud) and before systemd kills the QEMU scopes. Libvirt orders
# those scopes before virt-guest-shutdown.target, the same hook
# libvirt-guests.service (masked in favour of umbreld) relies on.
Wants=virt-guest-shutdown.target
After=libvirtd.service virtqemud.service virtlogd.service virt-guest-shutdown.target

[Service]
TimeoutStopSec=15min
# Trust the system CA store instead of the root store compiled into Node, so
# umbreld's trusted CAs are managed in one place with the rest of the OS.
Environment=NODE_OPTIONS=--use-openssl-ca
ExecStart=umbreld --data-directory=/home/umbrel/umbrel
Restart=always
# This prevents us hitting restart rate limits and ensures we keep restarting
# indefinitely.
StartLimitInterval=0

[Install]
WantedBy=multi-user.target
